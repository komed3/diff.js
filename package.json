{
  "name": "@komed3/diff.js",
  "description": "Fast text diff library, written in TypeScript",
  "license": "MIT",
  "version": "1.0.0",
  "author": {
    "name": "komed3 (Paul Köhler)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://github.com/komed3/diff.js",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komed3/diff.js.git"
  },
  "bugs": {
    "url": "https://github.com/komed3/diff.js/issues"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/komed3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./bundle": "./dist/bundle.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:dts": "tsc -p tsconfig.dts.json",
    "build:all": "npm run build:cjs && npm run build:esm && npm run build:dts",
    "format": "prettier --ignore-path \"\" --write \"./dist/**/*\" --log-level warn",
    "bundle": "esbuild dist/esm/index.js --bundle --minify --legal-comments=none --format=iife --global-name=diffJs --outfile=dist/bundle.js",
    "build": "npm run clean && npm run build:all && npm run format && npm run bundle",
    "postbuild": "tsc-alias && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/run.cjs",
    "benchmark": "npm run build && node benchmark/run.cjs",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tsc-alias": "^1.9.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

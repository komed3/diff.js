{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true
  },
  "tsc-alias": {
    "resolveFullPaths": true
  },
  "include": [ "src" ],
  "exclude": [ "node_modules", "dist" ]
}
